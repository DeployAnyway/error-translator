{
  "name": "@deployanyway/error-translator",
  "version": "0.1.1",
  "description": "Plain-English Node.js error explanations and debugging tips, because the stack trace has chosen violence.",
  "type": "module",
  "exports": "./src/index.js",
  "bin": {
    "error-translator": "./bin/cli.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeployAnyway/error-translator.git"
  },
  "bugs": {
    "url": "https://github.com/DeployAnyway/error-translator/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "prettier": "^3.6.2"
  },
  "keywords": [
    "nodejs",
    "javascript",
    "cli",
    "developer-tools",
    "debugging",
    "error-messages",
    "error-translator",
    "plain-english"
  ]
}
